# Local environment example — copy values from Railway Variables.
# Never commit real secrets.
#
# Either set DATABASE_URL, OR set the PG* pieces (same as Railway private network).

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

# PGHOST=xxxxx.railway.internal
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=railway

TRAINER_CODE=2468
SESSION_SECRET=replace-with-a-long-random-string
PORT=3000
